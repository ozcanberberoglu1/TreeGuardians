    en: Guardian is locked
    tr: "Muhaf\u0131z kilitli"
  - key: guardian_max_level
    en: Maximum level reached
    tr: "Maksimum seviyeye ula\u015F\u0131ld\u0131"
  - key: tool_locked
    en: Tool is locked
    tr: "Ara\xE7 kilitli"
  - key: tool_max_level
