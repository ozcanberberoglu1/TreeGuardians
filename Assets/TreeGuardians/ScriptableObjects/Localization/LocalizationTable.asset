    tr: Spor Bulutu
  - key: special_chain
    en: Chain Light
    tr: "Zincir I\u015F\u0131k"
  - key: special_shield
    en: Bark Wall
    tr: "Kabuk Duvar\u0131"
  - key: special_armor
    en: Oak Blessing
    tr: "Me\u015Fe Kutsamas\u0131"
  - key: special_tool_reset
    en: Quick Hands
    tr: "H\u0131zl\u0131 Eller"
  - key: special_team_buff
    en: Ancient Song
    tr: "Kadim \u015Eark\u0131"
