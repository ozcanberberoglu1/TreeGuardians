{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch",
      "mcp__unityMCP__read_console",
      "mcp__unityMCP__refresh_unity",
      "mcp__unityMCP__find_in_file",
      "mcp__unityMCP__find_gameobjects",
      "mcp__unityMCP__get_sha",
      "mcp__unityMCP__validate_script",
      "mcp__unityMCP__unity_docs",
      "mcp__unityMCP__unity_reflect"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git checkout -- :*)",
      "Bash(sudo:*)",
      "Bash(npm publish:*)",
      "mcp__unityMCP__manage_build",
      "mcp__unityMCP__execute_menu_item",
      "mcp__unityMCP__manage_packages"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/*.keystore)",
      "Read(./**/google-services.json)",
      "Read(//Users/**/.ssh/**)"
    ]
  }
}
